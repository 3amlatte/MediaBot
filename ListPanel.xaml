<UserControl x:Class="MediaRenamer.ListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBg}"
             AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <DockPanel Margin="8,6,8,4">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="List" FontSize="22" HorizontalAlignment="Center" Foreground="#C8C8C8" Margin="0,4,0,8"/>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Clear" Width="80" Margin="6,0,0,0" Click="Clear_Click"/>
                <Button DockPanel.Dock="Right" Content="Add Files..." Width="110" Click="AddFiles_Click"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TextMode" Content="Text" IsChecked="True" Margin="0,0,14,0" Checked="Mode_Changed"/>
                    <RadioButton x:Name="CsvMode" Content="CSV" Checked="Mode_Changed"/>
                </StackPanel>
            </DockPanel>
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Line template" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TemplateBox" TextChanged="Template_Changed"/>
            </DockPanel>
            <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Tokens: {original} {new} {path} {folder} {ext} {size} {status} {title} {season} {episode} {year}"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Copy" Width="90" Click="Copy_Click"/>
                <Button Content="Save..." Width="90" Margin="8,0,0,0" Click="Save_Click"/>
            </StackPanel>
            <TextBlock x:Name="InfoText" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,16,0" HorizontalAlignment="Right"/>
        </DockPanel>

        <ListBox x:Name="PreviewList" FontFamily="Consolas"/>
    </DockPanel>
</UserControl>
