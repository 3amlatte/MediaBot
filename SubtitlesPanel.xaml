<UserControl x:Class="MediaRenamer.SubtitlesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBg}"
             AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <DockPanel Margin="8,6,8,4">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Subtitles" FontSize="22" HorizontalAlignment="Center" Foreground="#C8C8C8" Margin="0,4,0,8"/>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Search Online" Width="120" Margin="6,0,0,0" Click="SearchOnline_Click"/>
                <Button DockPanel.Dock="Right" Content="Find Local" Width="110" Margin="6,0,0,0" Click="FindLocal_Click"/>
                <Button DockPanel.Dock="Right" Content="Add Files..." Width="110" Margin="6,0,0,0" Click="AddFiles_Click"/>
                <CheckBox x:Name="ConvertBox" Content="Convert to UTF-8" VerticalAlignment="Center" Margin="12,0,0,0" DockPanel.Dock="Right"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="Language:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="LangCombo" Width="220" DisplayMemberPath="Display"/>
                </StackPanel>
            </DockPanel>
            <TextBlock TextWrapping="Wrap" Foreground="Gray"
                       Text="Add video files here or drag them into this panel. Find Local looks for subtitle files in each video's folder. Search Online looks on OpenSubtitles (needs an API key in Preferences). Apply renames local files or saves downloads next to the videos."/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Apply" Width="90" Click="Apply_Click"/>
            <TextBlock x:Name="InfoText" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,16,0" HorizontalAlignment="Right"/>
        </DockPanel>

        <ListBox x:Name="SubsList" DisplayMemberPath="Display"/>
    </DockPanel>
</UserControl>
