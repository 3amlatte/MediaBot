<Window x:Class="MediaRenamer.MatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Match" Width="660" Height="520" MinWidth="480" MinHeight="360"
        Background="{StaticResource WindowBg}"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton x:Name="TvRadio" Content="TV Episodes" Margin="0,0,14,0"/>
                <RadioButton x:Name="MovieRadio" Content="Movies"/>
            </StackPanel>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Search" Width="80" Margin="6,0,0,0" Click="Search_Click"/>
                <TextBox x:Name="QueryBox" ToolTip="Show or movie title"/>
            </DockPanel>
            <TextBlock x:Name="InfoText" Foreground="Gray" Margin="0,0,0,6" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" Width="90" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="90" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ResultsBox" SelectionChanged="ResultsBox_SelectionChanged"
                     MouseDoubleClick="ResultsBox_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="42" Height="62" Margin="0,0,8,0">
                                <Border Background="#2A2C2E"/>
                                <Image Source="{Binding Poster}" Stretch="UniformToFill"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Subtitle}" Foreground="Gray" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="2" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="6"/>
                    <TextBlock x:Name="PreviewText" Foreground="Gray" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="10"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
